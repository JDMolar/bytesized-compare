---
export interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Frontier AI Model Matrix | bytesizedai.algotyx.com/compare",
  description = "Engineering workspace dashboard matrix comparing Claude Opus 5.5, GPT-6 Astra, GPT-6.1 Sol, Gemini 4 Argon, and Gemini 3.8 Flash Max across 8 workspace dimensions."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
  
  <!-- FontAwesome 6 CDN -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
</head>
<body class="bg-workspace-bg text-slate-100 font-sans antialiased selection:bg-cyan-500/30 selection:text-cyan-200 min-h-screen relative overflow-x-hidden">

  <!-- Ambient Workspace Radial Gradient Mesh -->
  <div class="fixed inset-0 pointer-events-none -z-10" aria-hidden="true">
    <div class="absolute -top-40 left-1/4 w-[650px] h-[450px] bg-indigo-900/15 rounded-full blur-[140px]"></div>
    <div class="absolute top-1/3 -right-20 w-[550px] h-[500px] bg-cyan-900/15 rounded-full blur-[130px]"></div>
    <div class="absolute -bottom-40 left-1/3 w-[600px] h-[400px] bg-emerald-950/15 rounded-full blur-[150px]"></div>
    <div class="absolute inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:28px_28px] opacity-[0.16]"></div>
  </div>

  <slot />

  <style is:global>
    /* Custom Sleek Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #070a11;
    }
    ::-webkit-scrollbar-thumb {
      background: #1e293b;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #334155;
    }

    /* Fixed Left Column Locked Shadow Separation */
    .sticky-col-header {
      position: sticky;
      left: 0;
      z-index: 30;
      background-color: #0b1120;
    }
    .sticky-col-cell {
      position: sticky;
      left: 0;
      z-index: 20;
      background-color: #0d1424;
      box-shadow: 4px 0 14px -2px rgba(0, 0, 0, 0.65);
    }
    tr:hover .sticky-col-cell {
      background-color: #121b30;
    }

    /* Cell Dimming on Filter */
    .cell-dimmed {
      opacity: 0.22;
      filter: grayscale(85%);
      transition: all 0.2s ease-in-out;
    }
    .cell-highlighted {
      transform: scale(1.015);
      transition: all 0.2s ease-in-out;
    }
  </style>
</body>
</html>
