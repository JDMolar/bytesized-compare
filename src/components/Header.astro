---
---

<header class="sticky top-0 z-40 backdrop-blur-xl bg-workspace-bg/85 border-b border-workspace-border/90 px-4 sm:px-6 lg:px-8 py-3 transition-all">
  <div class="max-w-[1720px] mx-auto flex flex-col md:flex-row md:items-center md:justify-between gap-3">
    
    <!-- Brand & Workspace Breadcrumb -->
    <div class="flex items-center gap-3.5 flex-wrap">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-cyan-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-indigo-500/20 text-white font-mono font-bold text-sm">
          <i class="fa-solid fa-microchip"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs uppercase tracking-wider text-slate-400">Workspace View</span>
            <span class="text-slate-600">/</span>
            <span class="font-mono text-xs text-cyan-400 font-semibold tracking-wide">bytesizedai.algotyx.com</span>
          </div>
          <h1 class="text-base sm:text-lg font-bold tracking-tight text-white flex items-center gap-2">
            Frontier Model Matrix <span class="text-xs px-2 py-0.5 rounded-full bg-slate-800 text-slate-300 font-mono font-normal border border-slate-700/60">Q4 2026 Audit</span>
          </h1>
        </div>
      </div>

      <div class="hidden sm:inline-flex items-center gap-2 ml-2 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 text-xs font-mono">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Pipeline: Active &bull; Low Latency Mode
      </div>
    </div>

    <!-- Quick Action Toolbar & Telemetry -->
    <div class="flex items-center gap-2.5 flex-wrap">
      <!-- Interactive Badge Filter Pills -->
      <div class="flex items-center gap-1 bg-workspace-surface/90 p-1 rounded-lg border border-workspace-border/80 text-xs font-mono">
        <button type="button" data-filter="all" id="btn-all" class="filter-btn px-2.5 py-1 rounded bg-slate-800 text-white font-medium transition-all shadow-sm">
          All <span class="text-slate-400 text-[10px] ml-0.5">(40)</span>
        </button>
        <button type="button" data-filter="Best in Class" id="btn-best" class="filter-btn px-2.5 py-1 rounded text-slate-300 hover:text-white transition-all">
          <i class="fa-solid fa-crown text-emerald-400 text-[10px] mr-1"></i>Best in Class
        </button>
        <button type="button" data-filter="Cost-Effective" id="btn-cost" class="filter-btn px-2.5 py-1 rounded text-slate-300 hover:text-white transition-all">
          <i class="fa-solid fa-bolt text-cyan-400 text-[10px] mr-1"></i>Cost-Effective
        </button>
        <button type="button" data-filter="Capable" id="btn-capable" class="filter-btn px-2.5 py-1 rounded text-slate-300 hover:text-white transition-all">
          <i class="fa-solid fa-check-double text-amber-400 text-[10px] mr-1"></i>Capable
        </button>
        <button type="button" data-filter="Premium Tier" id="btn-premium" class="filter-btn px-2.5 py-1 rounded text-slate-300 hover:text-white transition-all">
          <i class="fa-solid fa-gem text-purple-400 text-[10px] mr-1"></i>Premium
        </button>
      </div>

      <!-- Search Bar -->
      <div class="relative">
        <i class="fa-solid fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
        <input 
          type="text" 
          id="metricSearch" 
          placeholder="Search metric..." 
          class="pl-8 pr-3 py-1 bg-workspace-surface/80 border border-workspace-border/80 rounded-lg text-xs font-mono text-slate-200 placeholder-slate-500 focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-all w-32 sm:w-44" 
        />
      </div>

      <!-- Direct Navigation Anchor -->
      <a href="#matrix" class="hidden lg:flex items-center gap-1.5 px-3 py-1 text-xs font-mono bg-indigo-600/20 hover:bg-indigo-600/30 text-indigo-300 border border-indigo-500/40 rounded-lg transition-all">
        <i class="fa-solid fa-table-cells"></i> Matrix
      </a>
    </div>
  </div>
</header>
