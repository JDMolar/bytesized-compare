---
import type { SocialPlatform } from '../data/socials';

export interface Props {
  platform: SocialPlatform;
}

const { platform } = Astro.props;
---

<a 
  href={platform.url} 
  target="_blank" 
  rel="noopener noreferrer"
  class="group relative rounded-[22px] bg-white border border-[#EAE6DF] p-6 sm:p-7 shadow-[0_4px_24px_-4px_rgba(0,0,0,0.04)] hover:shadow-[0_12px_32px_-4px_rgba(0,0,0,0.08)] hover:border-[#D6D0C4] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between overflow-hidden focus:outline-none focus:ring-2 focus:ring-[#1D1D1F]/20"
>
  <div class="space-y-4">
    <!-- Platform Top Header -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3.5">
        <div class={`w-12 h-12 rounded-2xl ${platform.iconBg || 'bg-[#F5F3EF]'} border border-[#EAE6DF]/60 flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition-transform duration-300`}>
          <i class={`${platform.icon} ${platform.iconColor || 'text-[#1D1D1F]'}`}></i>
        </div>
        <div>
          <h3 class="text-base sm:text-lg font-semibold text-[#1D1D1F] tracking-tight group-hover:text-black transition-colors">
            {platform.name}
          </h3>
          <span class="text-xs text-[#86868B] font-normal block">
            {platform.handle}
          </span>
        </div>
      </div>

      <!-- Minimal Status Pill -->
      <span class="text-[11px] font-medium px-2.5 py-1 rounded-full bg-[#F5F3EF] text-[#6E6E73] border border-[#EAE6DF]/80 shrink-0">
        {platform.statusText}
      </span>
    </div>

    <!-- Platform Description -->
    <p class="text-[13px] sm:text-sm text-[#515154] leading-relaxed line-clamp-3">
      {platform.description}
    </p>
  </div>

  <!-- Bottom Channel Stats & Action Link -->
  <div class="mt-6 pt-4 border-t border-[#F2EFE9] flex items-center justify-between text-xs">
    <div class="flex items-center gap-1.5 text-[#86868B]">
      <span class="w-1.5 h-1.5 rounded-full bg-[#34C759]"></span>
      <span class="text-xs font-medium text-[#1D1D1F]">{platform.stats}</span>
    </div>
    
    <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-[#1D1D1F] group-hover:text-black transition-colors">
      <span>Connect</span>
      <svg class="w-3.5 h-3.5 text-[#86868B] group-hover:text-[#1D1D1F] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </span>
  </div>
</a>
