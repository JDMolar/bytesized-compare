---
import { tiers } from '../data/tiers';
import TierCard from './TierCard.astro';
---

<section id="tiers" class="space-y-4">
  <div class="flex items-center justify-between">
    <div>
      <span class="text-xs font-mono uppercase tracking-widest text-slate-400 flex items-center gap-2">
        <i class="fa-solid fa-layer-group text-cyan-400"></i> Tier Architecture
      </span>
      <h3 class="text-xl font-bold text-white tracking-tight">Optimal Multi-Model Pipeline Strategy</h3>
    </div>
    <span class="text-xs font-mono text-slate-500 hidden sm:inline-block">Configured for Autonomous Multi-Agent Toolchains</span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {tiers.map((tier) => (
      <TierCard tier={tier} />
    ))}
  </div>
</section>
