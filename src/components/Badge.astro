---
import type { BadgeType } from '../data/metrics';

export interface Props {
  badge: BadgeType;
}

const { badge } = Astro.props;

const badgeConfig: Record<BadgeType, { icon: string; classes: string }> = {
  "Best in Class": {
    icon: "fa-solid fa-crown",
    classes: "bg-emerald-500/10 text-emerald-400 border-emerald-500/30 shadow-emerald-500/20"
  },
  "Cost-Effective": {
    icon: "fa-solid fa-bolt",
    classes: "bg-cyan-500/10 text-cyan-400 border-cyan-500/30 shadow-cyan-500/20"
  },
  "Capable": {
    icon: "fa-solid fa-check-double",
    classes: "bg-amber-500/10 text-amber-400 border-amber-500/30 shadow-amber-500/20"
  },
  "Premium Tier": {
    icon: "fa-solid fa-gem",
    classes: "bg-purple-500/10 text-purple-400 border-purple-500/30 shadow-purple-500/20"
  }
};

const current = badgeConfig[badge] || badgeConfig["Capable"];
---

<span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-mono font-medium border shadow-sm ${current.classes}`}>
  <i class={`${current.icon} text-[10px]`}></i>
  {badge}
</span>
