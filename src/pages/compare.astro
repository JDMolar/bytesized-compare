---
import Layout from '../layouts/Layout.astro';
import NavHeader from '../components/NavHeader.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TierCards from '../components/TierCards.astro';
import MatrixTable from '../components/MatrixTable.astro';
import SpecsSection from '../components/SpecsSection.astro';
import Footer from '../components/Footer.astro';
---

<Layout 
  title="Frontier AI Model Matrix | bytesizedai.algotyx.com/compare"
  description="Engineering workspace dashboard matrix comparing Claude Opus 5.5, GPT-6 Astra, GPT-6.1 Sol, Gemini 4 Argon, and Gemini 3.8 Flash Max across 8 workspace dimensions."
>
  <!-- Global Navigation Header -->
  <NavHeader currentPath="/compare" />

  <!-- Matrix Action Header with Interactive Filters -->
  <Header />

  <main class="max-w-[1720px] mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
    <!-- Intro Hero & Telemetry KPI Row -->
    <Hero />

    <!-- 3 Multi-Model Pipeline Strategy Tier Cards -->
    <TierCards />

    <!-- 5-Model x 8-Dimension Evaluation Matrix -->
    <MatrixTable />

    <!-- Architectural Guardrails & Edge Specifications -->
    <SpecsSection />
  </main>

  <!-- Engineering Footer -->
  <Footer />
</Layout>
