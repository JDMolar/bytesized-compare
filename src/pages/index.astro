---
import Layout from '../layouts/Layout.astro';
import HomeHeader from '../components/HomeHeader.astro';
import SocialCard from '../components/SocialCard.astro';
import HomeFooter from '../components/HomeFooter.astro';
import { socialPlatforms } from '../data/socials';
---

<Layout 
  title="ByteSized AI | Official Syndication Channels"
  description="Official social media channels and creative syndication network for ByteSized AI."
  theme="cream"
>
  <HomeHeader />

  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16 space-y-12">
    <!-- Focused Apple Introduction -->
    <header class="max-w-2xl space-y-3">
      <p class="text-xs font-semibold uppercase tracking-wider text-[#86868B]">
        Distribution Network
      </p>
      <h1 class="text-3xl sm:text-5xl font-bold tracking-tight text-[#1D1D1F]">
        ByteSized AI
      </h1>
      <p class="text-base sm:text-lg text-[#6E6E73] font-normal leading-relaxed">
        Official social media channels &amp; creative syndication network.
      </p>
    </header>

    <!-- Social Media Syndication Channels Section -->
    <section class="space-y-6">
      <div class="flex items-center justify-between pb-3 border-b border-[#EAE6DF]">
        <h2 class="text-xs font-semibold uppercase tracking-wider text-[#86868B]">
          Syndicated Channels
        </h2>
        <span class="text-xs text-[#86868B] font-medium">
          7 Active Platforms
        </span>
      </div>

      <!-- 7 Social Media Cards Responsive Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {socialPlatforms.map((platform) => (
          <SocialCard platform={platform} />
        ))}
      </div>
    </section>
  </main>

  <HomeFooter />
</Layout>
